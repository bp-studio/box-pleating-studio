{
	"compilerOptions": {
		"lib": [
			"esnext",
			"dom",
			"dom.iterable"
		],
		"types": [
			"wicg-file-system-access",
			"scheduler-polyfill"
		],
		"paths": {
			"*": [
				"../*"
			]
		},
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"noImplicitOverride": true,
		"removeComments": true,
		"resolveJsonModule": true, // For resolving the type of `Locale`
		"skipLibCheck": true,
		"strict": true,
		"target": "es2018"
	}
}