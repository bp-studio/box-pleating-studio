{
	"compilerOptions": {
		"isolatedModules": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"noImplicitOverride": true,
		"preserveSymlinks": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "esnext",
		"paths": {
			"*": [
				"../src/*"
			]
		},
		"lib": [
			"esnext",
			"dom",
			"dom.iterable"
		]
	},
	"include": [
		"./**/*.ts",
		"../src/shared/types/**/*.d.ts"
	]
}